[
    {
        "database": "airline",
        "collection": "flights",
        "shardConfig": {
            "key": {
                "flight_id": 1
            }
        },
        "fields": {
            "flight_id": {
                "type": "int",
                "min": 100000,
                "max": 999999
            },
            "airline": {
                "type": "string",
                "provider": "airline"
            },
            "agent_first_name": {
                "type": "string",
                "provider": "first_name"
            },
            "agent_last_name": {
                "type": "string",
                "provider": "last_name"
            },
            "agent_email": {
                "type": "string",
                "provider": "email"
            },
            "flight_date": {
                "type": "date",
                "provider": "date_time"
            },
            "origin": {
                "type": "string",
                "provider": "city"
            },
            "destination": {
                "type": "string",
                "provider": "city"
            },
            "flight_code": {
                "type": "string",
                "provider": "flight_code"
            },
            "status": {
                "type": "string",
                "enum": ["scheduled", "boarding", "departed", "in_air", "landed", "delayed", "cancelled"]
            },
            "duration_minutes": {
                "type": "int",
                "provider": "duration_minutes",
                "min": 30,
                "max": 900
            },
            "gate": {
                "type": "string",
                "provider": "gate"
            },
            "equipment": {
                "type": "object",
                "provider": "equip"
            },
            "seats_available": {
                "type": "int",
                "provider": "seats_available"
            },
            "passengers": {
                "type": "array",
                "provider": "passengers"
            }
        },
        "indexes": [
            {
                "keys": {
                    "flight_id": 1,
                    "equipment.plane_type": 1
                }
            },
            {
                "keys": {
                    "flight_id": 1,
                    "seats_available": 1
                }
            },
            {
                "keys": {
                    "flight_id": 1,
                    "duration_minutes": 1,
                    "seats_available": 1
                }
            },
            {
                "keys": {
                    "equipment.plane_type": 1
                }
            },
            {
                "keys": {
                    "origin": 1,
                    "destination": 1,
                    "flight_date": -1
                }
            },
            {
                "keys": {
                    "status": 1
                }
            }
        ]
    }
]
